# Wankul TCG backend - production example
# Copy to .env on the server and fill real values.

NODE_ENV=production
PORT=3000

# Public URLs
APP_URL=https://example.com
FRONTEND_URL=https://example.com
CORS_ORIGINS=https://example.com,https://www.example.com

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=wankul_prod_user
DB_PASS=change_me
DB_NAME=wankul_prod
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_BACKUP_DIR=./backups

# JWT
JWT_SECRET=change_me_long_random_secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
ADMIN_JWT_SECRET=change_me_long_random_admin_secret
ADMIN_JWT_EXPIRES_IN=15m

# SMTP real provider
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@example.com
SMTP_PASS=change_me
MAIL_FROM="Wankul TCG <no-reply@example.com>"
SUPPORT_EMAIL=support@example.com
MAIL_LOGO_PATH=public/favicon.png

# Push notifications
# Generate with: npm run push:generate-vapid
PUSH_VAPID_PUBLIC_KEY=change_me
PUSH_VAPID_PRIVATE_KEY=change_me
PUSH_VAPID_SUBJECT=mailto:support@example.com
